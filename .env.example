# Локальные демо-значения. Для своих настроек скопируйте в .env (он в .gitignore) — .env переопределяет этот файл.

# --- PostgreSQL 17 (один инстанс, две БД: источник и DWH) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SOURCE_DB=deals_bigdata
DWH_DB=dwh

# --- Генерация источника (sql/synthetic.sql) ---
N_PRICES=300000

# --- Параметры пайплайна ---
# Дата снимка данных (а не системная дата запуска)
AS_OF=2026-10-26
# Окно загрузки по loading_date; пусто = весь диапазон источника (полный backfill)
ETL_START_DATE=
ETL_END_DATE=
# Воспроизводимость ML
RANDOM_SEED=42
LOG_LEVEL=INFO

# Apache Airflow
AIRFLOW_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_local_only
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_local_only_secret

# Apache Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin_local_only
SUPERSET_SECRET_KEY=change_me_local_only_superset_secret
